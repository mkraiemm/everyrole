# Copy to .env (never commit it). Real environment variables always win over this file.

# Jev, the model that picks each click (required).
TYPESAFE_API_KEY=
# Through the Vercel AI Gateway (use your gateway key as TYPESAFE_API_KEY):
TYPESAFE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
TYPESAFE_MODEL=typesafe-ai/jev
# Or TypeSafe directly:
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# Text helper (optional, any OpenAI-compatible API). Used only when a flow must type text
# and none of its named `values` fits the field.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
TEXT_MODEL=moonshotai/kimi-k3
TEXT_MODEL_REASONING=none

# Secrets your flows and user types reference as {{secrets.NAME}}. Add as many as you need.
# The quickstart example signs in with these (the local demo app accepts any email, e.g. demo@example.com,
# and any password of 8 or more characters):
DEMO_EMAIL=
DEMO_PASSWORD=
